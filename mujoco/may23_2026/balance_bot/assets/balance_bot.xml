<mujoco model="balance_bot">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option gravity="0 0 -9.81" timestep="0.002" integrator="RK4"/>
  <default>
    <joint armature="0.01"/>
    <geom friction="1 0.1 0.1" condim="3" rgba="0.6 0.6 0.7 1"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>
  <visual>
    <!-- Contact debug draw (when mjVIS_CONTACT* is enabled in the viewer). -->
    <scale contactwidth="0.015" contactheight="0.08" forcewidth="0.004"/>
    <rgba contactpoint="1 0.2 0.2 0.95" contactforce="1 0.55 0.1 0.9" contactfriction="0.2 0.8 1 0.85"/>
  </visual>
  <asset>
    <!-- Small skybox + matte floor (no reflectance) for lower GPU load -->
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.5 0.65" rgb2="0.1 0.15 0.25" width="256" height="256"/>
    <texture builtin="checker" height="64" name="texplane" rgb1="0.15 0.25 0.55" rgb2="0.25 0.40 0.75" type="2d" width="64"/>
    <material name="MatPlane" reflectance="0" shininess="0.1" specular="0" texrepeat="40 40" texture="texplane"/>
  </asset>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="MatPlane"/>
    <!-- World-frame axes at origin (RGB = XYZ). No collision — visual only. Gravity is -Z. -->
    <geom name="axis_x" type="capsule" size="0.012" fromto="0 0 0.04 0.35 0 0.04"
          rgba="1 0 0 0.9" contype="0" conaffinity="0"/>
    <geom name="axis_y" type="capsule" size="0.012" fromto="0 0 0.04 0 0.35 0.04"
          rgba="0 1 0 0.9" contype="0" conaffinity="0"/>
    <geom name="axis_z" type="capsule" size="0.012" fromto="0 0 0.04 0 0 0.39"
          rgba="0 0 1 0.9" contype="0" conaffinity="0"/>
    <!-- Cart slides on x; chassis pitches about y (wheel axle through left/right sides) -->
    <body name="cart" pos="0 0 0.03950000000000001">
      <joint name="slide" type="slide" axis="1 0 0" limited="true" range="-2.0 2.0"/>
      <geom name="axle_marker" type="sphere" size="0.015" rgba="0.3 0.3 0.3 1" mass="0.01"/>
      <!-- Wheels are rigidly attached to the axle/cart (they do NOT pitch with the chassis). -->
      <geom name="left_wheel" type="cylinder"
            size="0.032 0.0125"
            pos="0 -0.0925 -0.007500000000000007"
            quat="0.707107 0.707107 0 0"
            mass="0.024" rgba="0.15 0.15 0.15 1"/>
      <geom name="right_wheel" type="cylinder"
            size="0.032 0.0125"
            pos="0 0.0925 -0.007500000000000007"
            quat="0.707107 0.707107 0 0"
            mass="0.024" rgba="0.15 0.15 0.15 1"/>
      <body name="chassis">
        <joint name="hinge" type="hinge" axis="0 1 0"/>
        <!-- box: x=length, y=lateral, z=height; pos z = mass centre (battery-low bias) -->
        <geom name="body" type="box"
              size="0.0375 0.076 0.055"
              pos="0 0 0.032" mass="0.544" rgba="0.2 0.45 0.75 1"/>
        <!-- Measured chassis CoM (robot_params body_com_z); site does not add mass. -->
        <site name="body_cog" pos="0 0 0.032" size="0.04" rgba="1 0.92 0.15 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- Ideal drive: mean(τ_l,τ_r) → target slide speed (m/s); high kv ≈ unlimited torque. -->
    <velocity joint="slide" name="slide_vel" kv="200.0"
              ctrllimited="true" ctrlrange="-1.0 1.0"/>
  </actuator>
</mujoco>
